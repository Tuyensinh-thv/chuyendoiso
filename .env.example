# ==========================================
# Cấu hình Mẫu (.env.example) - HVU Chuyển Đổi Số
# ==========================================

# Client-side Supabase (Cần tiền tố VITE_ để Vite đọc được trên trình duyệt)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-jwt-key

# Kết nối trực tiếp PostgreSQL (Script migration)
SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-id
SUPABASE_DB_PASS=your-postgres-password

# Gemini AI (Tùy chọn)
GEMINI_API_KEY=
